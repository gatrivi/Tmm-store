# Admin Credentials (SHA-256 Hashes)
VITE_ADMIN_USER_HASH=
VITE_ADMIN_PASS_HASH=

# Product tier: menu | pedidos | premium
VITE_PLAN=pedidos

# Tenant identifier for Firestore sync (defaults to URL slug or "default")
VITE_TENANT_ID=

# Business Info
VITE_WHATSAPP_NUMBER=
VITE_BANK_ALIAS=

# Super admin provisioning (/super-admin)
VITE_SUPER_ADMIN_KEY=

# Firebase (optional — enables cloud sync + multi-device admin)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# MercadoPago (server-side only — never exposed to frontend)
MP_ACCESS_TOKEN=

# AI assistant (Premium tier — server-side only)
OPENAI_API_KEY=

# Firebase admin for MP webhook (server-side, same project)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
TENANT_ID=
