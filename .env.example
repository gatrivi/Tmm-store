# Admin Credentials (SHA-256 Hashes)
VITE_ADMIN_USER_HASH=
VITE_ADMIN_PASS_HASH=

# Product tier: menu | pedidos | premium
VITE_PLAN=pedidos

# Tenant identifier for Firestore sync (defaults to URL slug or "default")
VITE_TENANT_ID=

# Business Info
VITE_WHATSAPP_NUMBER=
VITE_BANK_ALIAS=

# Gatrivi.com sales landing (override optional — defaults: Gastón 5491156199363)
VITE_SALES_WHATSAPP_NUMBER=5491156199363
VITE_SALES_EMAIL=devtrivi@zengasoft.com

# Venta inicial de la tienda (Tally redirect → MP payment link)
# Price label must match the Mercado Pago payment link amount (ARS, no "USD 50")
VITE_DEMO_PRICE_LABEL=$65.000
VITE_DEMO_INTAKE_URL=

# Super admin provisioning (/super-admin)
VITE_SUPER_ADMIN_KEY=

# Firebase (optional — enables cloud sync + multi-device admin)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# MercadoPago (server-side only — never exposed to frontend)
MP_ACCESS_TOKEN=

# AI assistant (Premium — server-side only)
# Catalog match runs first (no LLM). Then optional provider:
# AI_PROVIDER=openai | anthropic | gemini
AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Firebase admin for MP webhook (server-side, same project)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
TENANT_ID=
