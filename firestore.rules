rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if true;

      match /orders/{orderId} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
      }

      // Browser checkout may only append a pending, tenant-scoped event.
      // Publishing/updating the outbox is reserved for a trusted backend worker.
      match /eventOutbox/{eventId} {
        allow read: if false;
        allow create: if
          request.resource.data.status == 'pending' &&
          request.resource.data.event.id == eventId &&
          request.resource.data.event.tenantid == tenantId &&
          request.resource.data.event.specversion == '1.0' &&
          request.resource.data.event.source == 'tmm-store' &&
          request.resource.data.event.type == 'commerce.order.created.v1';
        allow update, delete: if false;
      }
    }
  }
}
